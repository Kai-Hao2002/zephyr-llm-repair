FROM zephyr-oh-agent:1.55.1-z1
USER root
RUN apt-get -o Acquire::Retries=5 update && apt-get install -y --no-install-recommends iptables libcap2-bin && rm -rf /var/lib/apt/lists/*
COPY netlock-entrypoint /usr/local/bin/netlock-entrypoint
RUN chmod 755 /usr/local/bin/netlock-entrypoint
ENTRYPOINT ["/usr/local/bin/netlock-entrypoint"]
