FROM zephyr-oh-agent:1.55.1
USER root
# agent-server sets LD_LIBRARY_PATH to system libs for its own binary; it makes the Zephyr SDK's dtc crash
# (Floating-point exception), so shells started for the agent clear it.
RUN printf '\n# zephyr: SDK host tools need their own libraries\nunset LD_LIBRARY_PATH\n' >> /etc/bash.bashrc && \
    printf '\nunset LD_LIBRARY_PATH\n' >> /home/user/.bashrc && \
    printf '\nunset LD_LIBRARY_PATH\n' >> /home/user/.profile
COPY zephyr-run /usr/local/bin/zephyr-run
RUN chmod 755 /usr/local/bin/zephyr-run
